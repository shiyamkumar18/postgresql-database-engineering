# Subly PostgreSQL project — env overrides
# Copy to .env and edit as needed.

POSTGRES_USER=subly
POSTGRES_PASSWORD=subly
POSTGRES_DB=subly_test
POSTGRES_PORT=5432

# Used by Python scripts/tests
DATABASE_URL=postgresql://subly:subly@localhost:5432/subly_test

# For local (non-Docker) runs
LOCAL_PG_HOST=localhost
